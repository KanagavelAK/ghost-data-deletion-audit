# Copy to .env at the repository root (never commit or zip the real file).
# Only the screenshot extraction and the intent fallback/cross-check call an LLM;
# the main pipeline runs without any key.

# LLM provider: groq (default) or anthropic
GHOST_LLM_PROVIDER=groq
GROQ_API_KEY=

# Optional, only for GHOST_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional model overrides (defaults depend on the provider)
#   groq:      vision qwen/qwen3.8-27b, text openai/gpt-oss-20b
#   anthropic: vision claude-sonnet-5-5, text claude-haiku-5-5
GHOST_VISION_MODEL=
GHOST_TEXT_MODEL=
