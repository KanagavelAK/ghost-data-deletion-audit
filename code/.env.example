# Copy to .env at the repository root (never commit or zip the real file).
# Needed for screenshot extraction (python code/extract_images.py) and later LLM steps.
ANTHROPIC_API_KEY=
# Optional: vision model used for screenshot extraction.
GHOST_VISION_MODEL=claude-sonnet-5-5
# Optional: model for request-intent fallback and cross-check (python code/verify_intent.py).
GHOST_INTENT_MODEL=claude-haiku-5-5
